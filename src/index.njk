---
layout: base.njk
pageTitle: "My Town News — SF Neighborhood News, Every Friday"
pageDesc: "Free, independent hyperlocal news for every San Francisco neighborhood. Published every Friday."
---

{# The homepage is still San Francisco's front page. Editions now belong to
   cities, and this page loops them, so without scoping a Utah town appears on
   the SF map and in "Find Your Neighborhood" — which is exactly what happened
   the moment Heber City was added.

   This becomes the national homepage in Phase 3, at which point this filter is
   replaced by a city list rather than removed. #}
{% set sfEditions = clusters | inCity("san-francisco") %}

{# ── Hero ──────────────────────────────────────────────────────────────── #}
<header class="masthead home-hero" role="banner">
  <div class="container">
    <p class="home-hero__eyebrow">San Francisco · Free &amp; Independent · Every Friday</p>
    <h1 class="home-hero__title">My Town <em>News</em></h1>
    {% if featuredIssue %}
    <p class="home-hero__week">Week of <strong>{{ featuredIssue.weekOf | date_short }}</strong></p>
    {% endif %}
    <p class="home-hero__desc">
      Hyperlocal news for every San Francisco neighborhood — delivered to your inbox every Friday.
    </p>
  </div>
  <div class="gold-rule"></div>
</header>

{# ── Sticky nav ────────────────────────────────────────────────────────── #}
<nav class="site-nav" aria-label="Site navigation">
  <div class="site-nav__inner container">
    <a class="site-nav__logo" href="/" aria-label="My Town News home">{% inlineMark %}</a>
    <span class="site-nav__label">All San Francisco</span>
    <ul class="site-nav__links" role="list">
      <li><a href="#neighborhoods">Neighborhoods</a></li>
      <li><a href="#this-week">This Week</a></li>
      <li><a href="#newsletter">Newsletter</a></li>
    </ul>
    <div class="site-nav__right">
      <a class="site-nav__aux" href="/about/">About</a>
      <a class="site-nav__subscribe-btn" href="/subscribe/">Subscribe</a>
    </div>
  </div>
</nav>

<main id="main">

  {# ── Cluster Map Section ─────────────────────────────────────────────── #}
  <section id="neighborhoods" class="cluster-map-section" aria-labelledby="map-heading">
    <div class="container">
      <div class="cluster-map-section__intro">
        <h2 class="cluster-map-section__title" id="map-heading">Find Your Neighborhood</h2>
        <p class="cluster-map-section__sub">Click your part of the city or type your ZIP code below.</p>
      </div>

      <div class="cluster-map-wrap">

        {# ── Real Leaflet Map (OpenStreetMap) ────────────────────────── #}
        <div>
          <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
          <div id="sf-map" style="height:480px;border-radius:6px;border:1px solid var(--rule);overflow:hidden;" aria-label="San Francisco neighborhood map"></div>
          <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
          <script>
          (function() {
            var map = L.map('sf-map', {
              center: [37.766, -122.435],
              zoom: 12,
              scrollWheelZoom: false,
              zoomControl: true
            });

            // CARTO began requiring an API key for raster basemaps in late
            // August 2026 and started watermarking unauthenticated tiles with
            // "API KEY REQUIRED" — which appeared across this map without any
            // change on our side. CARTO is also retiring raster basemaps, so
            // taking one of their free keys would buy time on a product with a
            // published end date.
            //
            // OpenStreetMap's own tiles need no key. Note their usage policy
            // does not permit heavy use, so this is a stopgap, not a
            // destination: the durable answer is to stop depending on anyone
            // else's tile server.
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
              maxZoom: 16
            }).addTo(map);

            // Built from src/_data/clusters.json — the same file the pipeline
            // and the edition pages read. Previously this array hardcoded every
            // edition's coordinates, colour and neighbourhood list, so adding a
            // city meant remembering to edit it by hand.
            var clusters = [
              {%- for c in sfEditions %}
              { slug: {{ c.slug | dump | safe }},
                name: {{ c.name | dump | safe }},
                lat: {{ c.map.lat }}, lng: {{ c.map.lng }},
                color: {{ c.accent | dump | safe }},
                live: {{ "true" if c.live else "false" }},
                url: {{ (c | editionPath(clusters)) | dump | safe }},
                hoods: {{ c.map.short | dump | safe }} }{% if not loop.last %},{% endif %}
              {%- endfor %}
            ];

            clusters.forEach(function(c) {
              var radius = c.live ? 16 : 11;
              var marker = L.circleMarker([c.lat, c.lng], {
                radius: radius,
                fillColor: c.live ? c.color : '#b0aaa4',
                color: '#fff',
                weight: 2,
                opacity: 1,
                fillOpacity: c.live ? 0.92 : 0.55
              }).addTo(map);

              var label = '<strong>' + c.name + '</strong><br><span style="font-size:0.8em;color:#666">' + c.hoods + '</span>';
              if (!c.live) label += '<br><em style="font-size:0.75em;color:#999">Coming soon</em>';
              marker.bindTooltip(label, { sticky: true, direction: 'top', offset: [0, -8] });

              if (c.live) {
                marker.getElement() && (marker.getElement().style.cursor = 'pointer');
                marker.on('click', function() { window.location.href = c.url; });
                marker.on('add', function() {
                  var el = marker.getElement();
                  if (el) el.style.cursor = 'pointer';
                });
              }
            });
          })();
          </script>
        </div>

        {# ── Cluster list + ZIP lookup ──────────────────────────────── #}
        <div>
          <nav class="cluster-list" aria-label="Neighborhood clusters">
            {% for c in sfEditions %}
            {% if c.live %}
            <a class="cluster-list__item" href="{{ c | editionPath(clusters) }}"
               data-cluster="{{ c.slug }}"
               aria-label="{{ c.name }}: {{ c.neighborhoods | join(', ') }}">
              <span class="cluster-list__dot" style="background:{{ c.accent }}"></span>
              <div>
                <div class="cluster-list__name">{{ c.name }}</div>
                <div class="cluster-list__hoods">{{ c.neighborhoods | join(' · ') }}</div>
              </div>
              <span class="cluster-list__badge" style="background:{{ c.accent }}">Live</span>
            </a>
            {% else %}
            <div class="cluster-list__item" style="cursor:default;opacity:0.55"
                 data-cluster="{{ c.slug }}">
              <span class="cluster-list__dot" style="background:{{ c.accent }}"></span>
              <div>
                <div class="cluster-list__name">{{ c.name }}</div>
                <div class="cluster-list__hoods">{{ c.neighborhoods | join(' · ') }}</div>
              </div>
              <span style="font-family:var(--font-ui);font-size:0.5625rem;color:var(--muted);letter-spacing:0.08em;">Soon</span>
            </div>
            {% endif %}
            {% endfor %}
          </nav>

          {# ZIP lookup #}
          <div class="zip-lookup">
            <label class="zip-lookup__label" for="zip-input">Find by ZIP code</label>
            <div class="zip-lookup__row">
              <input class="zip-lookup__input" id="zip-input" type="text"
                     inputmode="numeric" pattern="[0-9]{5}"
                     maxlength="5" placeholder="e.g. 94133" aria-label="Enter SF ZIP code">
              <button class="zip-lookup__btn" id="zip-btn" type="button">Go</button>
            </div>
            <div class="zip-lookup__result" id="zip-result" role="status" aria-live="polite"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# ── This Week — Editor's Picks ──────────────────────────────────────── #}
  <section id="this-week" class="editors-picks" aria-labelledby="picks-heading">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__label" id="picks-heading">This Week — Editor's Picks</h2>
        <span class="section-head__line" aria-hidden="true"></span>
      </div>

      {# Feature the live cluster's top story #}
      {% set nwStory = featuredIssue.topStories[0] if (featuredIssue and featuredIssue.topStories and featuredIssue.topStories.length) else null %}
      {% if nwStory %}
      <div class="top-stories" style="grid-template-columns:2fr 1fr">
        <article class="story-main">
          <span class="nbadge" style="--accent:#c8943a;border-color:#c8943a;color:#c8943a">North Waterfront</span>
          {% if nwStory.tags and nwStory.tags.length %}<p class="tag" style="color:#c8943a">{{ nwStory.tags[0] }}</p>{% endif %}
          <h3 style="font-family:var(--font-head);font-size:clamp(1.25rem,2.2vw,1.75rem);font-weight:900;line-height:1.18;margin-bottom:12px;letter-spacing:-0.02em">
            {{ nwStory.headline }}
          </h3>
          {% if nwStory.dek %}<p class="byline">{{ nwStory.dek }}</p>{% endif %}
          <p style="font-size:var(--text-md);line-height:1.7;color:var(--text)">
            {{ (nwStory.body or "") | truncate(350) }}
          </p>
          <a href="/north-waterfront/" style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-ui);font-size:var(--text-xs);font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#c8943a;text-decoration:none;margin-top:16px;border-bottom:1px solid #c8943a">
            Read the full North Waterfront issue →
          </a>
        </article>

        {% if featuredIssue.topStories.length > 1 %}
        <div class="story-side" style="display:flex;flex-direction:column;gap:24px">
          {% for s in featuredIssue.topStories %}{% if loop.index > 1 %}
          <article>
            {% if s.tags and s.tags.length %}<span class="nbadge" style="--accent:#c8943a;border-color:#c8943a;color:#c8943a">{{ s.tags[0] }}</span>{% endif %}
            <h3 style="font-family:var(--font-head);font-size:1rem;font-weight:700;line-height:1.3;margin-top:4px;margin-bottom:8px">{{ s.headline }}</h3>
            <p style="font-size:var(--text-sm);line-height:1.65;color:var(--muted)">{{ (s.body or "") | truncate(160) }}</p>
          </article>
          {% endif %}{% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      {# Live cluster grid — all neighborhoods now active #}
      <div style="margin-top:40px">
        <div class="section-head">
          <h2 class="section-head__label">All SF Neighborhoods</h2>
          <span class="section-head__line"></span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px">
          {% for c in sfEditions %}
          {% if c.live %}
          <a href="{{ c | editionPath(clusters) }}" style="display:block;background:white;border:1px solid var(--rule);border-radius:var(--radius);padding:20px;border-top:3px solid {{ c.accent }};text-decoration:none;color:inherit;transition:box-shadow 0.15s ease;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='none'">
            <p style="font-family:var(--font-ui);font-size:var(--text-xs);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:{{ c.accent }};margin-bottom:6px">This Week →</p>
            <h3 style="font-family:var(--font-head);font-size:1rem;font-weight:700;margin-bottom:6px;color:var(--navy)">{{ c.name }}</h3>
            <p style="font-family:var(--font-ui);font-size:var(--text-xs);color:var(--muted);line-height:1.5">{{ c.neighborhoods | join(' · ') }}</p>
          </a>
          {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>
  </section>

  {# ── Newsletter ───────────────────────────────────────────────────────── #}
  <section id="newsletter" aria-labelledby="newsletter-heading">
    <div class="container">
      <div class="newsletter">
        <p class="newsletter__eyebrow">Free. Independent. Weekly.</p>
        <h2 class="newsletter__headline" id="newsletter-heading">Get My Town News<br>every Friday morning</h2>
        <p class="newsletter__sub">
          Neighborhood news, events, and your local directory — every edition, every week.
        </p>
        <form class="newsletter__form" aria-label="Newsletter signup">
          <input class="newsletter__input" type="email" placeholder="your@email.com" required aria-label="Email address">
          <button class="newsletter__btn" type="submit">Subscribe</button>
        </form>
        <p class="newsletter__note">No spam. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>

</main>

{% include "partials/footer.njk" %}

<script>
(function () {
  /* ZIP → cluster index (auto-generated from clusters.json via Nunjucks).
     ZIPs that span two clusters produce an array with both entries,
     so the user is offered a choice rather than silently picking one. */
  var zipIndex = {};
  [
    {% for c in sfEditions %}{% if c.live %}{% for z in c.zipCodes %}
    { zip: "{{ z }}", slug: "{{ c.slug }}", name: {{ c.name | dump | safe }}, url: {{ (c | editionPath(clusters)) | dump | safe }} },
    {% endfor %}{% endif %}{% endfor %}
  ].forEach(function (e) {
    if (!zipIndex[e.zip]) zipIndex[e.zip] = [];
    zipIndex[e.zip].push({ slug: e.slug, name: e.name, url: e.url });
  });

  var input  = document.getElementById('zip-input');
  var btn    = document.getElementById('zip-btn');
  var result = document.getElementById('zip-result');
  if (!input || !btn || !result) return;

  function lookup() {
    var zip = (input.value || '').trim();

    /* Reset */
    result.innerHTML = '';
    result.className = 'zip-lookup__result';

    if (!/^\d{5}$/.test(zip)) {
      result.textContent = 'Please enter a 5-digit ZIP code.';
      result.className += ' zip-lookup__result--warn';
      return;
    }

    var matches = zipIndex[zip];

    if (!matches || matches.length === 0) {
      result.textContent = 'ZIP ' + zip + ' isn’t in our coverage area yet. Browse the map above to find your neighborhood.';
      result.className += ' zip-lookup__result--warn';
      return;
    }

    if (matches.length === 1) {
      window.location.href = matches[0].url;
      return;
    }

    /* ZIP spans two editions — let the reader choose */
    result.innerHTML = 'ZIP ' + zip + ' is covered by two editions: ' +
      matches.map(function (m) {
        return '<a href="' + m.url + '">' + m.name + '</a>';
      }).join(' &nbsp;&middot;&nbsp; ');
    result.className += ' zip-lookup__result--multi';
  }

  btn.addEventListener('click', lookup);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') lookup();
  });
})();
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle or title or site.name }}</title>
  <meta name="description" content="{{ pageDesc or site.description }}">
  <meta property="og:title" content="{{ pageTitle or site.name }}">
  <meta property="og:description" content="{{ pageDesc or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📰</text></svg>">
</head>
<body{% if clusterSlug %} data-cluster="{{ clusterSlug }}"{% endif %}>

  {{ content | safe }}

  <script>
    // PDF download
    document.querySelectorAll('.btn-pdf').forEach(btn => {
      btn.addEventListener('click', () => window.print());
    });

    // Newsletter form handled per-page (cluster-layout.njk, subscribe.njk)

    /* ── Scrollspy: highlight the nav item for the section in view ────── */
    (function () {
      var links = Array.prototype.slice.call(
        document.querySelectorAll('.site-nav__links a[href^="#"]')
      );
      if (!links.length) return;

      var byId = {};
      var sections = [];
      links.forEach(function (link) {
        var id = link.getAttribute('href').slice(1);
        var el = id && document.getElementById(id);
        if (el) { byId[id] = link; sections.push(el); }
      });
      if (!sections.length) return;

      var current = null;
      function setActive(id) {
        if (id === current) return;
        current = id;
        links.forEach(function (l) {
          var on = l.getAttribute('href').slice(1) === id;
          l.classList.toggle('is-active', on);
          if (on) { l.setAttribute('aria-current', 'true'); }
          else    { l.removeAttribute('aria-current'); }
        });
      }

      // Clicking a tab highlights it right away, before the scroll settles
      links.forEach(function (link) {
        link.addEventListener('click', function () {
          setActive(link.getAttribute('href').slice(1));
        });
      });

      // Publish the real nav height so scroll-padding-top matches it exactly.
      // Measured rather than hard-coded because the nav wraps on narrow
      // screens, which would otherwise leave headings hidden underneath it.
      var nav = document.querySelector('.site-nav');
      function syncNavHeight() {
        var h = nav ? Math.round(nav.getBoundingClientRect().height) : 52;
        document.documentElement.style.setProperty('--nav-h', h + 'px');
        return h;
      }
      var navH = syncNavHeight();
      window.addEventListener('resize', function () { navH = syncNavHeight(); }, { passive: true });

      if (!('IntersectionObserver' in window)) return;

      var onView    = {};
      var lastId    = sections[sections.length - 1].id;
      var atBottom  = false;

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { onView[e.target.id] = e.isIntersecting; });
        if (atBottom) return;
        // Highlight the topmost section currently crossing the band
        for (var i = 0; i < sections.length; i++) {
          if (onView[sections[i].id]) { setActive(sections[i].id); return; }
        }
      }, {
        // Band starts just below the sticky nav, ends 55% up from the bottom
        rootMargin: '-' + (navH + 4) + 'px 0px -55% 0px',
        threshold: 0,
      });

      sections.forEach(function (s) { observer.observe(s); });

      window.addEventListener('scroll', function () {
        // Nothing selected at the very top of the page
        if (window.scrollY < 8) { atBottom = false; setActive(null); return; }

        // The final section is often too short to reach the detection band —
        // once the page bottoms out, keep it lit rather than falling back.
        var remaining = document.documentElement.scrollHeight
                      - window.scrollY - window.innerHeight;
        if (remaining < 120) {
          atBottom = true;
          setActive(lastId);
        } else if (atBottom) {
          atBottom = false;
        }
      }, { passive: true });
    })();
  </script>

</body>
</html>

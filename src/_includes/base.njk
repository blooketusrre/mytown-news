<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle or title or site.name }}</title>
  <meta name="description" content="{{ pageDesc or site.description }}">
  {# ── Social sharing ─────────────────────────────────────────────────────
     og:image was missing entirely, so every link shared in Slack, iMessage,
     WhatsApp or on social came through as a bare text link. Absolute URLs
     are required here — scrapers do not resolve relative paths. #}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle or site.name }}">
  <meta property="og:description" content="{{ pageDesc or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="My Town News — your neighborhood, in depth.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle or site.name }}">
  <meta name="twitter:description" content="{{ pageDesc or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/img/og-image.png">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/assets/css/main.css">

  {# ── Icons ──────────────────────────────────────────────────────────────
     Two raster sizes rather than one: the full mark loses its columns and
     clock face below about 24px, so 16px uses a simplified variant with
     fewer strokes. The SVG is offered to browsers that prefer it. #}
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png">
  <link rel="icon" type="image/svg+xml" href="/assets/img/mark.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png">
  <meta name="theme-color" content="#1a2744">

  {# ── Analytics ──────────────────────────────────────────────────────────
     Plausible: cookieless and storing no personal data, so no consent
     banner is required and nothing here conflicts with the privacy posture
     the rest of the site takes.

     The outbound-links variant matters for this publication specifically.
     Every story ends in a link to its source, so outbound clicks are the
     closest thing we have to a read-through metric — and they show which
     local outlets readers actually trust.

     Plausible ignores localhost automatically, so dev traffic stays out
     without extra configuration. Set analytics.enabled to false in
     site.json to remove the script entirely. #}
  {% if site.analytics and site.analytics.enabled and site.analytics.domain %}
  <script defer
          data-domain="{{ site.analytics.domain }}"
          src="https://plausible.io/js/script.outbound-links.js"></script>
  {% endif %}
</head>
<body{% if clusterSlug %} data-cluster="{{ clusterSlug }}"{% endif %}>

  {{ content | safe }}

  <script>
    // PDF download
    document.querySelectorAll('.btn-pdf').forEach(btn => {
      btn.addEventListener('click', () => window.print());
    });

    // Newsletter form handled per-page (cluster-layout.njk, subscribe.njk)

    /* ── Scrollspy: highlight the nav item for the section in view ────── */
    (function () {
      var links = Array.prototype.slice.call(
        document.querySelectorAll('.site-nav__links a[href^="#"]')
      );
      if (!links.length) return;

      var byId = {};
      var sections = [];
      links.forEach(function (link) {
        var id = link.getAttribute('href').slice(1);
        var el = id && document.getElementById(id);
        if (el) { byId[id] = link; sections.push(el); }
      });
      if (!sections.length) return;

      var current = null;
      function setActive(id) {
        if (id === current) return;
        current = id;
        links.forEach(function (l) {
          var on = l.getAttribute('href').slice(1) === id;
          l.classList.toggle('is-active', on);
          if (on) { l.setAttribute('aria-current', 'true'); }
          else    { l.removeAttribute('aria-current'); }
        });
      }

      // Clicking a tab highlights it right away, before the scroll settles
      links.forEach(function (link) {
        link.addEventListener('click', function () {
          setActive(link.getAttribute('href').slice(1));
        });
      });

      // Publish the real nav height so scroll-padding-top matches it exactly.
      // Measured rather than hard-coded because the nav wraps on narrow
      // screens, which would otherwise leave headings hidden underneath it.
      var nav = document.querySelector('.site-nav');
      function syncNavHeight() {
        var h = nav ? Math.round(nav.getBoundingClientRect().height) : 52;
        document.documentElement.style.setProperty('--nav-h', h + 'px');
        return h;
      }
      var navH = syncNavHeight();
      window.addEventListener('resize', function () { navH = syncNavHeight(); }, { passive: true });

      if (!('IntersectionObserver' in window)) return;

      var onView    = {};
      var lastId    = sections[sections.length - 1].id;
      var atBottom  = false;

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { onView[e.target.id] = e.isIntersecting; });
        if (atBottom) return;
        // Highlight the topmost section currently crossing the band
        for (var i = 0; i < sections.length; i++) {
          if (onView[sections[i].id]) { setActive(sections[i].id); return; }
        }
      }, {
        // Band starts just below the sticky nav, ends 55% up from the bottom
        rootMargin: '-' + (navH + 4) + 'px 0px -55% 0px',
        threshold: 0,
      });

      sections.forEach(function (s) { observer.observe(s); });

      window.addEventListener('scroll', function () {
        // Nothing selected at the very top of the page
        if (window.scrollY < 8) { atBottom = false; setActive(null); return; }

        // The final section is often too short to reach the detection band —
        // once the page bottoms out, keep it lit rather than falling back.
        var remaining = document.documentElement.scrollHeight
                      - window.scrollY - window.innerHeight;
        if (remaining < 120) {
          atBottom = true;
          setActive(lastId);
        } else if (atBottom) {
          atBottom = false;
        }
      }, { passive: true });
    })();
  </script>

</body>
</html>

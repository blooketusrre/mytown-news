---
layout: base.njk
---
{# ── Story rendering macros ───────────────────────────────────────────────
   These tolerate BOTH the original pipeline schema (neighborhood/tag/byline/
   date) and the current one (tags[]/dek). Fields are rendered only when
   present, so a future schema change degrades quietly instead of leaving
   orphaned separators or blank lines on the page. #}

{% macro storyHead(s) %}
  {% set badge = s.neighborhood or (s.tags[0] if s.tags and s.tags.length else "") %}
  {% if badge %}<span class="nbadge">{{ badge }}</span>{% endif %}
  {% if s.tag %}<p class="tag">{{ s.tag }}</p>{% endif %}
  <h3>{{ s.headline }}</h3>
  {% if s.dek %}<p class="dek">{{ s.dek }}</p>{% endif %}
  {% if s.byline and s.date %}
    <p class="byline">{{ s.byline }} &nbsp;·&nbsp; {{ s.date }}</p>
  {% elif s.byline %}
    <p class="byline">{{ s.byline }}</p>
  {% elif s.date %}
    <p class="byline">{{ s.date }}</p>
  {% endif %}
{% endmacro %}

{# Excerpt rather than full text: enough to hook the reader, short enough that
   every card in a row settles at the same height. The wider lead story gets a
   larger word budget so it fills the same number of lines as its narrower
   neighbours. CSS line-clamps as a backstop for unusually long sentences. #}
{% macro storyBody(s, words) %}
  <div class="story-body">
    <p>{{ s.body | excerpt(words or 60) }}</p>
  </div>
  {% if s.sourceUrl %}
  <a href="{{ s.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="source-link">
    Read the full story: {{ s.sourceName or "source" }} →
  </a>
  {% endif %}
{% endmacro %}

{# ── PDF download bar ─────────────────────────────────────────────────── #}
<div class="pdf-bar">
  <span class="pdf-bar__label">Save this week's edition:</span>
  <button class="btn-pdf" aria-label="Download as PDF">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="8 17 12 21 16 17"/><line x1="12" y1="12" x2="12" y2="21"/>
      <path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"/>
    </svg>
    Download PDF
  </button>
</div>

{# ── Masthead ──────────────────────────────────────────────────────────── #}
<header class="masthead" role="banner">
  <div class="masthead__inner container">
    <p class="masthead__eyebrow">{{ site.tagline }}</p>
    <h1 class="masthead__title">My Town <em>News</em><br>{{ issue.clusterName if issue else clusterName }}</h1>
    <div class="masthead__ornament" aria-hidden="true">
      <span class="masthead__ornament-rule"></span>
      <span class="masthead__ornament-diamond"></span>
      <span class="masthead__ornament-rule"></span>
    </div>
    {# Which neighborhoods this edition covers. A reader who lands here from
       search knows their own neighborhood, not our name for the group it
       sits in — someone in Telegraph Hill has no reason to guess that it
       lives inside "North Waterfront".

       Read from clusters.json, not from the generated issue. This line used
       to render issue.neighborhoods, which the pipeline schema never asked
       Claude to produce, so it was empty on every edition page from launch
       until 2026-08-27 and nothing complained. The edition definition always
       has the list, and it shows on the "coming Friday" pages too. #}
    {% set edition = clusters | bySlug(clusterSlug) %}
    {% if edition and edition.neighborhoods.length %}
    <p class="masthead__subtitle">
      <span class="masthead__subtitle-label">Covering</span>
      {{ edition.neighborhoods | join(' · ') }}
    </p>
    {% endif %}
  </div>
  <div class="masthead__bar">
    <div class="masthead__bar-inner container">
      {% if issue %}<span class="masthead__bar-date">Week of <strong>{{ issue.weekOf | date_short }}</strong></span>{% else %}<span class="masthead__bar-date">Coming Friday</span>{% endif %}
      <a href="{{ site.url }}" class="masthead__bar-url">{{ site.url | replace("https://","") }}</a>
      <span>{{ site.city }} &nbsp;·&nbsp; Free &amp; Independent</span>
    </div>
  </div>
</header>

<div class="gold-rule"></div>

{# ── Sticky nav ───────────────────────────────────────────────────────── #}
<nav class="site-nav" aria-label="Edition sections">
  <div class="site-nav__inner container">
    <a class="site-nav__logo" href="/" aria-label="My Town News — all San Francisco neighborhoods"
       title="All San Francisco neighborhoods">{% inlineMark %}</a>
    <span class="site-nav__label">{{ issue.clusterName if issue else clusterName }}</span>
    <ul class="site-nav__links" role="list">
      <li><a href="#top-stories">Top Stories</a></li>
      <li><a href="#events">Events</a></li>
      <li><a href="#more-news">More News</a></li>
      <li><a href="#directory">Directory</a></li>
      <li><a href="#sources">Sources</a></li>
    </ul>
    <div class="site-nav__right">
      <a class="site-nav__subscribe-btn" href="/subscribe/">Subscribe</a>
      <span class="site-nav__meta">{% if issue %}{{ issue.weekOf | date_short }}{% endif %}</span>
    </div>
  </div>
</nav>

{# ── Main content ─────────────────────────────────────────────────────── #}
<main class="page-main" id="main">

  <div class="container">

  {% if not issue or not issue.topStories or issue.topStories.length == 0 %}

    {# No content yet — first issue coming soon #}
    <div style="text-align:center;padding:80px 20px 100px;max-width:480px;margin:0 auto">
      <p style="font-family:var(--font-head);font-size:3rem;margin-bottom:8px">📰</p>
      <h2 style="font-family:var(--font-head);font-size:1.75rem;font-weight:900;color:var(--navy);margin-bottom:16px">First Issue Coming Friday</h2>
      <p style="font-size:var(--text-md);line-height:1.7;color:var(--muted)">
        My Town News publishes every Friday. The first issue for this edition is on its way — check back soon, or <a href="/#newsletter" style="color:var(--accent)">sign up for the newsletter</a> to be notified.
      </p>
      <a href="/" style="display:inline-block;margin-top:32px;font-family:var(--font-ui);font-size:var(--text-xs);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);text-decoration:none;border-bottom:1px solid var(--accent)">← Back to all neighborhoods</a>
    </div>

  {% else %}

    {# Top Stories #}
    <section id="top-stories" aria-labelledby="top-stories-heading">
      <div class="section-head">
        <h2 class="section-head__label" id="top-stories-heading">This Week's Top Stories</h2>
        <span class="section-head__line" aria-hidden="true"></span>
      </div>

      <div class="top-stories">

        {# Main story — widest column, so the largest word budget #}
        <article class="story-main">
          {{ storyHead(issue.topStories[0]) }}
          {{ storyBody(issue.topStories[0], 110) }}
        </article>

        {# Side stories #}
        {% for s in issue.topStories %}{% if loop.index > 1 %}
        <article class="story-side">
          {{ storyHead(s) }}
          {{ storyBody(s, 55) }}
        </article>
        {% endif %}{% endfor %}

      </div>
    </section>

    {# Events #}
    <section id="events" aria-labelledby="events-heading">
      <div class="events-band">
        <div class="section-head section-head--light">
          <h2 class="section-head__label" id="events-heading">Upcoming &amp; Ongoing in the Neighborhood</h2>
          <span class="section-head__line" aria-hidden="true"></span>
        </div>

        <div class="events-grid">
          {% for ev in issue.events %}
          <div class="event-card">
            {% if ev.ongoing or ev.date == "Ongoing" %}
              <span class="event-card__badge">Ongoing</span>
            {% elif ev.date %}
              <p class="event-card__date">{{ ev.date }}{% if ev.recurring %} &nbsp;·&nbsp; {{ ev.recurring }}{% endif %}</p>
            {% endif %}
            <h3 class="event-card__title">{{ ev.title }}</h3>
            <p class="event-card__desc">{{ ev.description }}</p>
            <ul class="event-card__meta" role="list">
              {% if ev.location %}
              <li>
                <svg class="event-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13 6.6c0 3.9-5 8.4-5 8.4S3 10.5 3 6.6a5 5 0 0 1 10 0Z"/>
                  <circle cx="8" cy="6.5" r="1.9"/>
                </svg>
                <span class="u-visually-hidden">Location:</span>{{ ev.location }}
              </li>
              {% endif %}
              {% if ev.time %}
              <li>
                <svg class="event-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.2"/>
                  <path d="M8 4.4V8l2.5 1.6"/>
                </svg>
                <span class="u-visually-hidden">Time:</span>{{ ev.time }}
              </li>
              {% endif %}
              {% if ev.price %}
              <li>
                <svg class="event-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 6.3V4.4a.9.9 0 0 1 .9-.9h10.2a.9.9 0 0 1 .9.9v1.9a1.7 1.7 0 0 0 0 3.4v1.9a.9.9 0 0 1-.9.9H2.9a.9.9 0 0 1-.9-.9V9.7a1.7 1.7 0 0 0 0-3.4Z"/>
                  <path d="M9.6 5.9v.9M9.6 9.2v.9"/>
                </svg>
                <span class="u-visually-hidden">Price:</span>{{ ev.price }}
              </li>
              {% endif %}
            </ul>
            {% if ev.sourceUrl %}
            <a href="{{ ev.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="event-card__source">
              Verify details →
            </a>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    {# More News #}
    <section id="more-news" aria-labelledby="more-news-heading">
      <div class="section-head">
        <h2 class="section-head__label" id="more-news-heading">More from the Neighborhood</h2>
        <span class="section-head__line" aria-hidden="true"></span>
      </div>

      <div class="more-news-grid">
        {% for s in issue.moreNews %}
        <article class="news-card">
          {{ storyHead(s) }}
          {{ storyBody(s, 50) }}
        </article>
        {% endfor %}
      </div>
    </section>

    <hr class="divider">

    {# Directory #}
    <section id="directory" aria-labelledby="directory-heading">
      <div class="directory">
        <div class="section-head">
          <h2 class="section-head__label" id="directory-heading">Neighborhood Directory</h2>
          <span class="section-head__line" aria-hidden="true"></span>
        </div>

        {# ── Restaurants & Cafés ──────────────────────────────────── #}
        {% if issue.directory and issue.directory.restaurants %}
          {% set restList = issue.directory.restaurants %}
        {% else %}
          {% set restList = [] %}
        {% endif %}
        <div class="dir-section dir-section--collapsible" id="dir-restaurants">
          <button class="dir-section__toggle"
                  aria-expanded="false"
                  aria-controls="dir-restaurants-body"
                  type="button">
            <span class="dir-section__emoji">🍽</span>
            <span class="dir-section__title">Restaurants &amp; Cafés</span>
            {% if restList.length %}<span class="dir-section__count">{{ restList.length }}</span>{% endif %}
            <svg class="dir-section__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </button>
          <div class="dir-section__body is-collapsed" id="dir-restaurants-body">
            {% if restList.length %}
              {% set restGroups = restList | groupBy("cuisineGroup") %}
              {% for groupName, entries in restGroups %}
              <div class="dir-group">
                {% if groupName %}<h4 class="dir-group__heading">{{ groupName }}</h4>{% endif %}
                <div class="dir-group__entries">
                  {% for e in entries %}
                  <div class="dir-entry">
                    <div class="dir-entry__badges">
                      {% if e.neighborhood %}<span class="dir-entry__badge">{{ e.neighborhood }}</span>{% endif %}
                      {% if e.notable %}<span class="dir-entry__badge dir-entry__badge--{{ e.notable | badgeClass }}">{{ e.notable }}</span>{% endif %}
                    </div>
                    <p class="dir-entry__name">{{ e.name }}</p>
                    <p class="dir-entry__type">{{ e.type or e.cuisine }}</p>
                    {% if e.description %}<p class="dir-entry__detail">{{ e.description }}</p>{% endif %}
                    <p class="dir-entry__meta">{% if e.address %}{{ e.address }}{% endif %}{% if e.phone %} &nbsp;·&nbsp; {{ e.phone }}{% endif %}</p>
                    {% if e.website %}<a class="dir-entry__website" href="{{ e.website }}" target="_blank" rel="noopener noreferrer">Visit website →</a>{% endif %}
                  </div>
                  {% endfor %}
                </div>
              </div>
              {% endfor %}
            {% else %}
              <p class="dir-empty">No listings yet — check back after the first issue.</p>
            {% endif %}
          </div>
        </div>

        {# ── Hotels & Lodging ─────────────────────────────────────── #}
        {% if issue.directory and issue.directory.hotels %}
          {% set hotelList = issue.directory.hotels %}
        {% else %}
          {% set hotelList = [] %}
        {% endif %}
        <div class="dir-section dir-section--collapsible" id="dir-hotels">
          <button class="dir-section__toggle"
                  aria-expanded="false"
                  aria-controls="dir-hotels-body"
                  type="button">
            <span class="dir-section__emoji">🏨</span>
            <span class="dir-section__title">Hotels &amp; Lodging</span>
            {% if hotelList.length %}<span class="dir-section__count">{{ hotelList.length }}</span>{% endif %}
            <svg class="dir-section__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </button>
          <div class="dir-section__body is-collapsed" id="dir-hotels-body">
            {% if hotelList.length %}
              <div class="dir-group">
                <div class="dir-group__entries">
                  {% for e in hotelList %}
                  <div class="dir-entry">
                    <div class="dir-entry__badges">
                      {% if e.neighborhood %}<span class="dir-entry__badge">{{ e.neighborhood }}</span>{% endif %}
                      {% if e.notable %}<span class="dir-entry__badge dir-entry__badge--{{ e.notable | badgeClass }}">{{ e.notable }}</span>{% endif %}
                    </div>
                    <p class="dir-entry__name">{{ e.name }}</p>
                    <p class="dir-entry__type">{{ e.type }}</p>
                    {% if e.description %}<p class="dir-entry__detail">{{ e.description }}</p>{% endif %}
                    <p class="dir-entry__meta">{% if e.address %}{{ e.address }}{% endif %}{% if e.phone %} &nbsp;·&nbsp; {{ e.phone }}{% endif %}</p>
                    {% if e.website %}<a class="dir-entry__website" href="{{ e.website }}" target="_blank" rel="noopener noreferrer">Visit website →</a>{% endif %}
                  </div>
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <p class="dir-empty">No listings yet.</p>
            {% endif %}
          </div>
        </div>

        {# ── Shops, Books & Services ──────────────────────────────── #}
        {% if issue.directory and issue.directory.shops %}
          {% set shopList = issue.directory.shops %}
        {% else %}
          {% set shopList = [] %}
        {% endif %}
        <div class="dir-section dir-section--collapsible" id="dir-shops">
          <button class="dir-section__toggle"
                  aria-expanded="false"
                  aria-controls="dir-shops-body"
                  type="button">
            <span class="dir-section__emoji">🛍</span>
            <span class="dir-section__title">Shops, Books &amp; Services</span>
            {% if shopList.length %}<span class="dir-section__count">{{ shopList.length }}</span>{% endif %}
            <svg class="dir-section__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </button>
          <div class="dir-section__body is-collapsed" id="dir-shops-body">
            {% if shopList.length %}
              {% set shopGroups = shopList | groupBy("shopGroup") %}
              {% for groupName, entries in shopGroups %}
              <div class="dir-group">
                {% if groupName %}<h4 class="dir-group__heading">{{ groupName }}</h4>{% endif %}
                <div class="dir-group__entries">
                  {% for e in entries %}
                  <div class="dir-entry">
                    <div class="dir-entry__badges">
                      {% if e.neighborhood %}<span class="dir-entry__badge">{{ e.neighborhood }}</span>{% endif %}
                      {% if e.notable %}<span class="dir-entry__badge dir-entry__badge--{{ e.notable | badgeClass }}">{{ e.notable }}</span>{% endif %}
                    </div>
                    <p class="dir-entry__name">{{ e.name }}</p>
                    <p class="dir-entry__type">{{ e.type }}</p>
                    {% if e.description %}<p class="dir-entry__detail">{{ e.description }}</p>{% endif %}
                    <p class="dir-entry__meta">{% if e.address %}{{ e.address }}{% endif %}{% if e.phone %} &nbsp;·&nbsp; {{ e.phone }}{% endif %}</p>
                    {% if e.website %}<a class="dir-entry__website" href="{{ e.website }}" target="_blank" rel="noopener noreferrer">Visit website →</a>{% endif %}
                  </div>
                  {% endfor %}
                </div>
              </div>
              {% endfor %}
            {% else %}
              <p class="dir-empty">No listings yet.</p>
            {% endif %}
          </div>
        </div>

        {# ── Art & Entertainment ───────────────────────────────────── #}
        {% if issue.directory and issue.directory.artEntertainment %}
          {% set artList = issue.directory.artEntertainment %}
        {% else %}
          {% set artList = [] %}
        {% endif %}
        <div class="dir-section dir-section--collapsible" id="dir-art">
          <button class="dir-section__toggle"
                  aria-expanded="false"
                  aria-controls="dir-art-body"
                  type="button">
            <span class="dir-section__emoji">🎭</span>
            <span class="dir-section__title">Art &amp; Entertainment</span>
            {% if artList.length %}<span class="dir-section__count">{{ artList.length }}</span>{% endif %}
            <svg class="dir-section__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </button>
          <div class="dir-section__body is-collapsed" id="dir-art-body">
            {% if artList.length %}
              {% set artGroups = artList | groupBy("venueGroup") %}
              {% for groupName, entries in artGroups %}
              <div class="dir-group">
                {% if groupName %}<h4 class="dir-group__heading">{{ groupName }}</h4>{% endif %}
                <div class="dir-group__entries">
                  {% for e in entries %}
                  <div class="dir-entry">
                    <div class="dir-entry__badges">
                      {% if e.neighborhood %}<span class="dir-entry__badge">{{ e.neighborhood }}</span>{% endif %}
                      {% if e.notable %}<span class="dir-entry__badge dir-entry__badge--{{ e.notable | badgeClass }}">{{ e.notable }}</span>{% endif %}
                    </div>
                    <p class="dir-entry__name">{{ e.name }}</p>
                    <p class="dir-entry__type">{{ e.type }}</p>
                    {% if e.description %}<p class="dir-entry__detail">{{ e.description }}</p>{% endif %}
                    <p class="dir-entry__meta">{% if e.address %}{{ e.address }}{% endif %}{% if e.phone %} &nbsp;·&nbsp; {{ e.phone }}{% endif %}</p>
                    {% if e.website %}<a class="dir-entry__website" href="{{ e.website }}" target="_blank" rel="noopener noreferrer">Visit website →</a>{% endif %}
                  </div>
                  {% endfor %}
                </div>
              </div>
              {% endfor %}
            {% else %}
              <p class="dir-empty">No listings yet.</p>
            {% endif %}
          </div>
        </div>

        {# ── Gyms & Recreation ────────────────────────────────────── #}
        {% if issue.directory and issue.directory.gymsRecreation %}
          {% set gymList = issue.directory.gymsRecreation %}
        {% else %}
          {% set gymList = [] %}
        {% endif %}
        <div class="dir-section dir-section--collapsible" id="dir-gyms">
          <button class="dir-section__toggle"
                  aria-expanded="false"
                  aria-controls="dir-gyms-body"
                  type="button">
            <span class="dir-section__emoji">🏃</span>
            <span class="dir-section__title">Gyms &amp; Recreation</span>
            {% if gymList.length %}<span class="dir-section__count">{{ gymList.length }}</span>{% endif %}
            <svg class="dir-section__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </button>
          <div class="dir-section__body is-collapsed" id="dir-gyms-body">
            {% if gymList.length %}
              {% set gymGroups = gymList | groupBy("venueGroup") %}
              {% for groupName, entries in gymGroups %}
              <div class="dir-group">
                {% if groupName %}<h4 class="dir-group__heading">{{ groupName }}</h4>{% endif %}
                <div class="dir-group__entries">
                  {% for e in entries %}
                  <div class="dir-entry">
                    <div class="dir-entry__badges">
                      {% if e.neighborhood %}<span class="dir-entry__badge">{{ e.neighborhood }}</span>{% endif %}
                      {% if e.notable %}<span class="dir-entry__badge dir-entry__badge--{{ e.notable | badgeClass }}">{{ e.notable }}</span>{% endif %}
                    </div>
                    <p class="dir-entry__name">{{ e.name }}</p>
                    <p class="dir-entry__type">{{ e.type }}</p>
                    {% if e.description %}<p class="dir-entry__detail">{{ e.description }}</p>{% endif %}
                    <p class="dir-entry__meta">{% if e.address %}{{ e.address }}{% endif %}{% if e.phone %} &nbsp;·&nbsp; {{ e.phone }}{% endif %}</p>
                    {% if e.website %}<a class="dir-entry__website" href="{{ e.website }}" target="_blank" rel="noopener noreferrer">Visit website →</a>{% endif %}
                  </div>
                  {% endfor %}
                </div>
              </div>
              {% endfor %}
            {% else %}
              <p class="dir-empty">No listings yet.</p>
            {% endif %}
          </div>
        </div>

        <script>
        (function() {
          document.querySelectorAll('.dir-section__toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var isExpanded = btn.getAttribute('aria-expanded') === 'true';
              btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
              var body = document.getElementById(btn.getAttribute('aria-controls'));
              if (body) body.classList.toggle('is-collapsed', isExpanded);
            });
          });
        })();
        </script>

        {# ── Report a correction ────────────────────────────────── #}
        <div class="dir-correction">
          <p>Know of a listing that's wrong or a business that's closed?
            <a href="mailto:{{ site.email }}?subject=Directory correction: {{ issue.clusterName if issue else clusterName }}&body=Venue name: %0ACorrection: %0A%0AThank you!" class="dir-correction__link">Report a correction →</a>
          </p>
        </div>

      </div>
    </section>

    {# Sources #}
    <section id="sources" aria-labelledby="sources-heading">
      <div class="sources-section">
        <div class="section-head">
          <h2 class="section-head__label" id="sources-heading">Sources &amp; Editorial Notes</h2>
          <span class="section-head__line" aria-hidden="true"></span>
        </div>

        <div class="editorial-note">
          Stories in My Town News are compiled from public sources, and with assistance from AI.
          Please verify important details at the cited source.
          All named individuals appear only in their publicly documented roles.
          Directory listings reflect publicly available contact information and are updated periodically.
        </div>

        <div class="sources-grid">
          {% for src in issue.sources %}
          <div class="source-item">
            <span class="source-num">{{ loop.index }}</span>
            <div>
              <p class="source-item__title">{{ src.title }}</p>
              <p class="source-item__org">
                {{ src.org }} &nbsp;·&nbsp;
                <a href="{{ src.url }}" target="_blank" rel="noopener noreferrer">{{ src.url }}</a>
              </p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

  </div>{# /container #}

  {# Newsletter #}
  <div class="container">
    <div class="newsletter">
      <p class="newsletter__eyebrow">Stay connected</p>
      <h2 class="newsletter__headline">Get the {{ issue.clusterName }}<br>delivered every Friday</h2>
      <p class="newsletter__sub">The week's neighborhood news, events, and directory — straight to your inbox. Free.</p>
      {# Native form post — Buttondown's embed endpoint only supports real form
         submissions. A fetch() cannot hand the subscriber over for CAPTCHA or
         validation, and with mode:'no-cors' the response is unreadable, so the
         old version reported success even when the signup silently failed. #}
      <form class="newsletter__form embeddable-buttondown-form"
            action="https://buttondown.com/api/emails/embed-subscribe/{{ site.buttondownUser }}"
            method="post"
            aria-label="Newsletter signup">
        <input type="hidden" name="tag" value="{{ clusterSlug }}">
        <input type="hidden" name="embed" value="1">
        <label class="visually-hidden" for="nl-email-{{ clusterSlug }}">Email address</label>
        <input class="newsletter__input" id="nl-email-{{ clusterSlug }}"
               type="email" name="email" placeholder="your@email.com"
               required autocomplete="email">
        <button class="newsletter__btn" type="submit">Subscribe</button>
      </form>
      <p class="newsletter__note" id="cluster-nl-note">No spam. Unsubscribe anytime. &nbsp;·&nbsp; <a href="/subscribe/" style="color:var(--accent);font-weight:700">Subscribe to more neighborhoods →</a></p>
    </div>
  </div>

  {% endif %}

</main>

{# Footer #}
{% include "partials/footer.njk" %}

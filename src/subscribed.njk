---
layout: base.njk
permalink: /subscribed/
pageTitle: "Confirm your email — My Town News"
pageDesc: "One more step: confirm your email address to start receiving My Town News."
eleventyExcludeFromCollections: true
---

{# Landing page for Buttondown's subscription_redirect_url. Buttondown posts
   the signup, then sends the reader back here so the journey ends on our own
   site rather than on buttondown.com. #}

{# Buttondown treats a signup as unconfirmed until the reader clicks the
   link in its confirmation email, and sends unconfirmed addresses nothing.
   This page used to be headed "You're Subscribed", which told readers they
   were done. In October a reader who never confirmed waited for a Friday
   issue that was never going to come. So the headline is the step they still
   have to take, and the spam folder is a numbered step, not small print. #}

<header class="masthead home-hero" role="banner" style="padding-bottom:var(--sp-8)">
  <div class="container">
    <p class="home-hero__eyebrow">One more step</p>
    <h1 class="home-hero__title" style="font-size:clamp(2rem,5vw,3.25rem)">Confirm your<br><em>email</em></h1>
    <p class="home-hero__desc" style="max-width:560px">
      You&rsquo;re not subscribed yet. We&rsquo;ve sent you a confirmation email &mdash;
      <strong>nothing arrives until you click the link inside it.</strong>
    </p>
  </div>
  <div class="gold-rule"></div>
</header>

{# The site's top bar, as on every other page: the logo links home. Readers
   arrive here from an email, often in a fresh tab, with no other sign of
   which site they are on. #}
<nav class="site-nav" aria-label="Site navigation">
  <div class="site-nav__inner container">
    <a class="site-nav__logo" href="/" aria-label="My Town News home">{% inlineMark %}</a>
    <span class="site-nav__label">My Town News</span>
    <div class="site-nav__right">
      <a class="site-nav__aux" href="/">Go to MyTown.news &rarr;</a>
    </div>
  </div>
</nav>

<main id="main">
  <div class="container">
    <div class="sub-page">

      <div class="sub-confirm" role="status">
        <ol class="sub-confirm__steps">
          <li>
            <strong>Open the email from {{ site.senderEmail }}.</strong>
            It usually arrives within a minute or two.
          </li>
          <li>
            <strong>Not there? Check your spam, junk or promotions folder.</strong>
            First emails from a new sender often land there. If you find it,
            mark it &ldquo;not spam&rdquo;.
          </li>
          <li>
            <strong>Click the confirmation link.</strong>
            That&rsquo;s what turns on your subscription. Your first issue
            arrives the following Friday morning.
          </li>
        </ol>
        <p class="sub-confirm__tip">
          Add <a href="mailto:{{ site.senderEmail }}">{{ site.senderEmail }}</a> to your
          contacts so future issues land in your inbox. Still nothing after ten
          minutes? Sign up again &mdash; a typo in the address is the usual cause.
          <a href="/subscribe/">Back to the sign-up page &rarr;</a>
        </p>
      </div>

      <div class="sub-section-head" style="margin-top:var(--sp-10)">
        <h2 class="sub-section-title">While you wait</h2>
      </div>

      <p style="font-size:var(--text-md);line-height:1.7;color:var(--muted);margin-bottom:var(--sp-6)">
        Every edition is free to read on the site — no subscription needed.
        Here's this week's coverage.
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:var(--sp-4);margin-bottom:var(--sp-10)">
        {% for c in clusters %}{% if c.live %}
        <a href="{{ c | editionPath(clusters) }}"
           style="display:block;background:var(--white);border:1px solid var(--rule);border-radius:var(--radius);padding:var(--sp-5);border-top:3px solid {{ c.accent }};text-decoration:none;color:inherit">
          <h3 style="font-family:var(--font-head);font-size:1rem;font-weight:700;margin-bottom:4px;color:var(--navy)">{{ c.name }}</h3>
          <p style="font-family:var(--font-ui);font-size:var(--text-xs);color:var(--muted);line-height:1.5">{{ c.neighborhoods | join(' · ') }}</p>
        </a>
        {% endif %}{% endfor %}
      </div>

      {# The page used to end here, with the browser's back button as the only
         way out. A reader who arrived from one edition wants that edition;
         everyone else wants the front page. Both, named, before the fold of
         small print. The `from` parameter is set by the subscribe page. #}
      <div class="sub-onward" id="sub-onward">
        <a class="sub-onward__primary" id="sub-onward-edition" href="/" hidden></a>
        <a class="sub-onward__secondary" href="/">Go to MyTown.news &rarr;</a>
      </div>

      <p class="sub-note">
        Changed your mind about which editions?
        <a href="/subscribe/" style="color:var(--accent);font-weight:700">Update your selection &rarr;</a>
      </p>

<script>
(function () {
  /* Where the reader came from, remembered by the subscribe page just before
     it submitted.

     Not a query parameter: the form POSTs to buttondown.com and Buttondown
     then redirects to a fixed URL from its own settings, so anything in our
     query string is dropped on the way. sessionStorage survives that round
     trip because the tab never changes and the origin coming back is ours.

     Wrapped because Safari in private mode and some managed browsers throw on
     access rather than returning null. An unknown or missing slug just leaves
     the link hidden — never guess a destination. */
  var slug = null;
  try { slug = sessionStorage.getItem("mtn:from"); sessionStorage.removeItem("mtn:from"); } catch (e) {}
  if (!slug) return;
  var editions = {
    {%- for c in clusters %}{% if c.live %}
    {{ c.slug | dump | safe }}: { name: {{ c.name | dump | safe }}, url: {{ (c | editionPath(clusters)) | dump | safe }} },
    {%- endif %}{% endfor %}
  };
  var e = editions[slug];
  if (!e) return;
  var a = document.getElementById("sub-onward-edition");
  a.href = e.url;
  a.textContent = "Back to " + e.name + " \u2192";
  a.hidden = false;
})();
</script>

    </div>
  </div>
</main>
